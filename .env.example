# 이 파일을 .env 로 복사한 뒤 값만 채워 넣는다.
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (bash)
# .env 는 .gitignore 에 있어 커밋되지 않는다. 실제 값은 여기 적지 말 것.

# ---------------------------------------------------------------------------
# [필수] FRED API 키
# ---------------------------------------------------------------------------
# https://fred.stlouisfed.org/docs/api/api_key.html 에서 무료로 발급받는다.
FRED_API_KEY=

# ---------------------------------------------------------------------------
# [필수] MQWAY 게시 대상 사이트
# ---------------------------------------------------------------------------
# 스킴과 호스트까지만 적는다. 끝의 /api 는 코드가 붙인다.
# 형제 프로젝트 krx-daily-brief 와 같은 이름, 같은 규칙이다.
#   BASE_URL=http://localhost   ->  http://localhost/api/board-research
BASE_URL=http://localhost

# 게시판(board-research), 작성자(admin), 카테고리(유동성)는 고정값이라
# 환경변수로 받지 않는다. src/liquidity_feed/config.py 를 본다.
# MQWAY 인증 키는 없다. DB 를 쓰지 않으므로 DATABASE_URL 도 없다.

# ---------------------------------------------------------------------------
# [선택] 텔레그램 알림
# ---------------------------------------------------------------------------
# 스케줄러가 새벽에 조용히 실패하면 알 방법이 없다. 설정을 권장한다.
# BOT_TOKEN 은 @BotFather 에서, CHAT_ID 는 봇을 초대한 방에서 확인한다.
# 형제 프로젝트 krx-daily-brief 와 같은 이름이라 값을 그대로 옮겨도 된다.
TELEGRAM_BOT_TOKEN=
# 게시 성공 알림이 가는 방
TELEGRAM_CHAT_ID=
# 실패 알림이 가는 방. 비우면 위 방으로 간다
TELEGRAM_CHAT_TEST_ID=
